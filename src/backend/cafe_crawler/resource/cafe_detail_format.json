    "reviews": [
        {
            "name": "places/ChIJLemzQ901aDQRH56DkeKXk_E/reviews/ChdDSUhNMG9nS0VJQ0FnSUNpeF8tWHVBRRAB",
            "relativePublishTimeDescription": "3 years ago",
            "rating": 5,
            "text": {
                "text": "Quiet small, designer coffee shop with food. On the first floor are a few seats alongside designer products to buy and the counter to order at. The second floor houses the main seating area (if you can call it that with less than 30 seats). Zhu Coffee had a really nice cool vibe and a view onto the park. I bought a excellent Kenyan coffee (180 NT) and the most expensive cake they had (a nice homemade cinnamon roll at 150NT). You're paying for the ambiance as much as the drinks/food, but it was worth it.",
                "languageCode": "en"
            },
            "originalText": {
                "text": "Quiet small, designer coffee shop with food. On the first floor are a few seats alongside designer products to buy and the counter to order at. The second floor houses the main seating area (if you can call it that with less than 30 seats). Zhu Coffee had a really nice cool vibe and a view onto the park. I bought a excellent Kenyan coffee (180 NT) and the most expensive cake they had (a nice homemade cinnamon roll at 150NT). You're paying for the ambiance as much as the drinks/food, but it was worth it.",
                "languageCode": "en"
            },
            "authorAttribution": {
                "displayName": "Bob Cook",
                "uri": "https://www.google.com/maps/contrib/113314347498798056711/reviews",
